<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    >

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- M2.4: partial WakeLock keeps the CPU alive for the wake pipeline
         when the screen is off in hands-free mode. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:label="Natalie M2.4 Hands-Free"
        android:icon="@android:drawable/ic_btn_speak_now"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name="com.natalie.assistant.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="com.natalie.assistant.ListeningForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

    </application>
</manifest>
