package com.natalie.assistant

/**
 * Relay credentials — COPY TO RelaySecrets.kt AND FILL IN, NEVER COMMIT THE REAL FILE.
 *
 * This is the PHONE role token (can send messages + read replies only).
 * It is NOT the privileged NATALIE server token.
 *
 * For a production build, replace this with a user-entered setup screen
 * storing the token in EncryptedSharedPreferences.
 */
object RelaySecrets {
    // Get this from whoever runs the relay backend. Do NOT hardcode in git.
    const val PHONE_TOKEN = "PASTE_PHONE_TOKEN_HERE"
}
